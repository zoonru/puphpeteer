ARG BASE_IMAGE=puphpeteer-base
FROM ${BASE_IMAGE} AS chrome-download
USER root
WORKDIR /tmp/browser-install
COPY upstream/lock.json ./upstream/lock.json
COPY src/Internal/BrowserInstallation.php ./src/Internal/BrowserInstallation.php
COPY tools/install-browser.php ./tools/install-browser.php
RUN PUPPETEER_SKIP_DOWNLOAD=false PUPPETEER_CACHE_DIR=/opt/chrome php tools/install-browser.php \
    && php -r 'require "src/Internal/BrowserInstallation.php"; putenv("PUPPETEER_CACHE_DIR=/opt/chrome"); symlink((new \Nesk\Puphpeteer\Internal\BrowserInstallation(getcwd()))->executable(), "/opt/chrome/executable");' \
    && chmod -R a+rX /opt/chrome

FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libx11-xcb1 \
    fonts-liberation ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=chrome-download /opt/chrome /opt/chrome
RUN ln -s /opt/chrome/executable /usr/local/bin/chrome
ENV PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chrome
USER app
