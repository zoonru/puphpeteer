{
  "name": "@zoon/puphpeteer",
  "private": true,
  "description": "Build and browser test tooling for the embedded QuickJS client.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "build:check": "node tools/build.cjs --check",
    "test-generator": "node --test tools/upstream/*.test.cjs",
    "browser:install": "node -e \"const vars=['PUPPETEER_SKIP_DOWNLOAD','PUPPETEER_CHROME_SKIP_DOWNLOAD','PUPPETEER_SKIP_CHROME_DOWNLOAD']; process.exit(vars.some(k => /^(1|true|yes)$/i.test(process.env[k] ?? '')) ? 0 : 1)\" || npm run browser:install:run",
    "browser:install:run": "npx --no-install @puppeteer/browsers install chrome@$(node -p \"require('./upstream/lock.json').package.chromeBuildId\") --path node_modules/.puphpeteer",
    "postinstall": "npm run browser:install",
    "test-plugins": "node --test tests/Plugins/*.test.cjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.2",
    "@types/node": "25.6.0",
    "esbuild": "0.25.12",
    "puppeteer-core": "25.10.0",
    "puppeteer-extra-plugin": "3.2.3",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "typescript": "5.9.3",
    "web-streams-polyfill": "4.3.0"
  }
}
