{
  "name": "@zoon/puphpeteer",
  "private": true,
  "description": "Build and browser test tooling for the embedded QuickJS client.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "php bin/console build --no-interaction",
    "build:check": "php bin/console build --check --no-interaction",
    "test-generator": "node --test tests/Generator/Puppeteer/*.test.cjs",
    "test-plugins": "node --test tests/Plugins/Puppeteer/*.test.cjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.6",
    "@types/node": "24.19.2",
    "abort-controller": "3.0.0",
    "core-js": "3.51.0",
    "esbuild": "0.28.2",
    "fingerprint-generator": "2.1.89",
    "fingerprint-injector": "2.1.89",
    "puppeteer-core": "25.14.0",
    "puppeteer-extra-plugin": "3.2.3",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "typescript": "6.0.3",
    "web-streams-polyfill": "4.3.0"
  }
}
