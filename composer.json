{
  "name": "zoon/puphpeteer",
  "description": "A PHP client running Puppeteer in embedded QuickJS.",
  "keywords": [
    "php",
    "puppeteer",
    "headless-chrome",
    "testing",
    "web",
    "developer-tools",
    "automation"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Johann Pardanaud",
      "email": "pardanaud.j@gmail.com"
    },
    {
      "name": "Alexander Pankratov",
      "email": "s.pankratoff@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-php_quickjs": "*",
    "amphp/amp": "^3.1",
    "amphp/websocket-client": "^2.0",
    "amphp/process": "^2.1",
    "amphp/http-client": "^5.3",
    "amphp/byte-stream": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "vimeo/psalm": "^7.0.0-beta19",
    "nikic/php-parser": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Nesk\\Puphpeteer\\": "src/"
    },
    "files": [
      "src/compatibility.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Nesk\\Puphpeteer\\Tests\\": "tests/",
      "Zoon\\Puphpeteer\\Tooling\\": "tools/php/src/"
    }
  },
  "scripts": {
    "test": "@test-unit",
    "psalm": "@php vendor/bin/psalm",
    "check": [
      "@test",
      "@psalm"
    ],
    "build": "npm run build",
    "test-browser": "@php tests/Browser/run-smoke.php",
    "benchmark": "@php benchmarks/run.php",
    "test-unit": "@php vendor/bin/phpunit",
    "test-integration": "@php vendor/bin/phpunit tests/Integration",
    "update-php": "node tools/upstream/update.cjs",
    "verify-php": "node tools/upstream/update.cjs --check",
    "test-generator": "@php vendor/bin/phpunit --testsuite Generator"
  },
  "config": {
    "sort-packages": true
  }
}
